{
  "name": "glance-ai",
  "version": "1.0.0",
  "description": "A lightweight, always-on-top workspace companion for AI assistants",
  "main": "src/main/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "test": "node tests/runner.js",
    "test:smoke": "electron test_smoke.js",
    "test-bench": "node tools/focus-tester/server.js",
    "dist": "electron-builder --win portable"
  },
  "keywords": [
    "ai",
    "assistant",
    "gemini",
    "chatgpt",
    "claude",
    "perplexity",
    "productivity",
    "overlay",
    "developer-tools",
    "workspace"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.glanceai.app",
    "productName": "Glance AI",
    "compression": "maximum",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable"
      ]
    },
    "forceCodeSigning": false,
    "portable": {
      "artifactName": "Glance-AI-Portable.exe"
    },
    "files": [
      "src/**/*",
      "package.json"
    ]
  }
}